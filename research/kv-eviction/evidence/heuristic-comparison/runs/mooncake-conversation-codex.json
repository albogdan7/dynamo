    "heuristic_baselines": {
      "fifo": {
        "label": "FIFO",
        "source": "class EvictionPolicy:\n    def select_victim(self, blocks: list[dict]) -> int:\n        return min(blocks, key=lambda block: block[\"creation_order\"])[\"block_id\"]\n",
        "note": "Allocation-order FIFO: evict the oldest physical copy, rather than the oldest cache publication."
      },
      "mru": {
        "label": "MRU",
        "source": "class EvictionPolicy:\n    def select_victim(self, blocks: list[dict]) -> int:\n        return min(blocks, key=lambda block: -block[\"lru_rank\"])[\"block_id\"]\n",
        "note": "Evict the newest eligible copy in the native inactive release queue; the opposite end from LRU."
      },
      "lfu": {
        "label": "LFU",
        "source": "class EvictionPolicy:\n    def select_victim(self, blocks: list[dict]) -> int:\n        return min(blocks, key=lambda block: (block[\"hit_count\"], block[\"lru_rank\"]))[\"block_id\"]\n",
        "note": "Least physical-copy accesses, then native LRU. Initial computed use counts once; each committed cached-prefix activation adds one, including overlapping readers. Canceled reservations do not count. Counts reset on reallocation."
      },
      "slru": {
        "label": "SLRU",
        "source": "class EvictionPolicy:\n    def select_victim(self, blocks: list[dict]) -> int:\n        return min(blocks, key=lambda block: (block[\"hit_count\"] >= 2, block[\"lru_rank\"]))[\"block_id\"]\n",
        "note": "SGLang-style segmented LRU: copies with at least two actual accesses are protected behind the probationary tier; native LRU within each tier. This is the two-tier hit-threshold variant, not a bounded protected queue."
      },
      "random-0": {
        "label": "Random 0",
        "seed": 0,
        "source": "import random\n\nclass EvictionPolicy:\n    def __init__(self):\n        self.rng = random.Random(0)\n\n    def select_victim(self, blocks: list[dict]) -> int:\n        return self.rng.choice(sorted(blocks, key=lambda block: block[\"lru_rank\"]))[\"block_id\"]\n",
        "note": "Uniform random replacement over native eligible candidates, ordered by LRU rank. Fixed seed 0; fresh PRNG per replay. All three seeds are reported separately without selecting a best seed."
      },
      "random-1": {
