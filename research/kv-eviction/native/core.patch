+// SPDX-License-Identifier: Apache-2.0
+//! Research-only hooks. No forecast, active-block access, or changes to scheduling.
+use std::collections::HashMap;
+use std::fs::File;
+use std::io::{BufWriter, Write};
+use std::path::Path;
+use std::sync::{Mutex, OnceLock};
+use std::sync::atomic::{AtomicU64, Ordering};
+use anyhow::Result;
+use rand::{Rng, SeedableRng, rngs::StdRng};
+use serde::Serialize;
+
+#[derive(Serialize)]
+pub struct Candidate {
+    pub block_id: u64,
+    pub creation_order: u64,
+    pub release_order: u64,
+    pub num_releases: u64,
+    pub lru_rank: usize,
+    pub hit_count: u64,
+    pub last_access_order: u64,
+}
+type Callback = Box<dyn Fn(&[Candidate]) -> Result<u64> + Send + Sync>;
+static CALLBACK: OnceLock<Callback> = OnceLock::new();
+static TOKENS: OnceLock<Mutex<BufWriter<File>>> = OnceLock::new();
+static EVICTIONS: AtomicU64 = AtomicU64::new(0);
+static PROTECTED_EVICTIONS: AtomicU64 = AtomicU64::new(0);
+pub fn set_callback(callback: Callback) { assert!(CALLBACK.set(callback).is_ok()); }
+pub fn capture_tokens(path: impl AsRef<Path>) -> Result<()> {
+    assert!(TOKENS.set(Mutex::new(BufWriter::new(File::create(path)?))).is_ok()); Ok(())
+}
+/// Flush buffered token events; a run that fails before this is discarded.
+pub fn finish_tokens() -> Result<()> {
+    if let Some(file) = TOKENS.get() { file.lock().unwrap().flush()?; }
+    Ok(())
+}
+pub fn enabled() -> bool { CALLBACK.get().is_some() }
+pub fn choose(candidates: &[Candidate]) -> u64 {
+    CALLBACK.get().expect("callback missing")(candidates).expect("invalid policy decision")
+}
+pub fn count_eviction() { EVICTIONS.fetch_add(1, Ordering::Relaxed); }
+pub fn evictions() -> u64 { EVICTIONS.load(Ordering::Relaxed) }
+pub fn count_protected_eviction() { PROTECTED_EVICTIONS.fetch_add(1, Ordering::Relaxed); }
+pub fn protected_evictions() -> u64 { PROTECTED_EVICTIONS.load(Ordering::Relaxed) }
+pub fn token(uuid: impl std::fmt::Display, time_ms: f64) {
+    if let Some(file) = TOKENS.get() {
+        writeln!(file.lock().unwrap(), "{}", serde_json::json!({"uuid":uuid.to_string(),"time_ms":time_ms})).unwrap();
+    }
+}
+
+/// Native victim order over the same eligible candidates as the callback.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NativeOrder { Lru, Lfu, Slru, Random, Protected }
+static ORDER: OnceLock<NativeOrder> = OnceLock::new();
+static RNG: OnceLock<Mutex<StdRng>> = OnceLock::new();
+pub fn set_native_order(order: NativeOrder, seed: u64) {
+    assert!(ORDER.set(order).is_ok());
+    assert!(RNG.set(Mutex::new(StdRng::seed_from_u64(seed))).is_ok());
+}
+pub fn native_order() -> NativeOrder { ORDER.get().copied().unwrap_or(NativeOrder::Lru) }
+/// Candidates arrive in native LRU order, so index 0 is the LRU head.
+pub fn choose_native(candidates: &[Candidate]) -> u64 {
+    let pick = match native_order() {
+        NativeOrder::Lfu => candidates.iter().min_by_key(|c| (c.hit_count, c.lru_rank)),
+        NativeOrder::Slru => candidates.iter().min_by_key(|c| (c.hit_count >= 2, c.lru_rank)),
+        NativeOrder::Random => {
+            let index = RNG.get().expect("random order needs a seed").lock().unwrap().random_range(0..candidates.len());
+            candidates.get(index)
+        }
+        NativeOrder::Lru | NativeOrder::Protected => candidates.first(),
+    };
+    pick.expect("eviction requires a candidate").block_id
+}
+
+// Simulated time of the current scheduler pass or command, stored as f64 bits.
+static NOW: AtomicU64 = AtomicU64::new(0);
+static RELEASE_PROTECTION: AtomicU64 = AtomicU64::new(0xfff0_0000_0000_0000); // -inf
+pub fn set_now(now_ms: f64) { NOW.store(now_ms.to_bits(), Ordering::Relaxed); }
+pub fn now() -> f64 { f64::from_bits(NOW.load(Ordering::Relaxed)) }
+/// Protection applied to copies released by the request now finishing.
+pub fn set_release_protection(until_ms: f64) { RELEASE_PROTECTION.store(until_ms.to_bits(), Ordering::Relaxed); }
+pub fn release_protection() -> f64 { f64::from_bits(RELEASE_PROTECTION.load(Ordering::Relaxed)) }
+
+/// What a retention policy may see when a request finishes: no future arrivals.
+#[derive(Serialize)]
+pub struct Pause {
+    pub session_id: Option<String>,
+    pub arrival_ms: f64,
+    pub now_ms: f64,
+    pub input_tokens: usize,
+    pub cached_input_tokens: usize,
+    pub output_tokens: usize,
+}
+pub type RetentionCallback = Box<dyn Fn(&Pause) -> Result<Option<f64>> + Send + Sync>;
+
+/// Log-spaced histogram of observed pauses, 1 ms to 10^9 ms, 40 bins per decade.
+struct PauseHistogram { counts: Vec<u64>, total: u64 }
+impl PauseHistogram {
+    const BINS_PER_DECADE: f64 = 40.0;
+    fn new() -> Self { Self { counts: vec![0; 361], total: 0 } }
+    fn edge(index: usize) -> f64 { 10f64.powf(index as f64 / Self::BINS_PER_DECADE) }
+    fn add(&mut self, gap_ms: f64) {
+        let index = if gap_ms <= 1.0 { 0 } else { (gap_ms.log10() * Self::BINS_PER_DECADE).ceil() as usize };
+        let last = self.counts.len() - 1;
+        self.counts[index.min(last)] += 1;
+        self.total += 1;
+    }
+    /// Upper bin edge reached by the median observation.
+    fn median(&self) -> Option<f64> {
+        let mut seen = 0;
+        for (index, count) in self.counts.iter().enumerate() {
+            seen += count;
+            if self.total > 0 && 2 * seen >= self.total { return Some(Self::edge(index)); }
+        }
+        None
+    }
+    /// Continuum: argmax over candidate TTLs of P(pause <= ttl) * benefit - ttl.
+    fn best_ttl(&self, benefit_ms: f64) -> f64 {
+        let (mut best, mut best_value, mut seen) = (0.0, 0.0, 0);
+        for (index, count) in self.counts.iter().enumerate() {
+            seen += count;
+            if *count == 0 { continue; }
+            let ttl = Self::edge(index);
+            let value = seen as f64 / self.total as f64 * benefit_ms - ttl;
+            if value > best_value { best = ttl; best_value = value; }
+        }
+        best
+    }
+}
+
+pub enum RetentionPolicy {
+    None,
+    LastGap,
+    GlobalMedian,
+    /// Reload cost a*n^2 + b*n + c for n context tokens; exponential(mean) cold start.
+    Continuum { reload: [f64; 3], min_history: u64, cold_mean_ms: f64 },
+    /// Upper bound only: recorded gap after each session's k-th request.
+    Oracle { gaps: HashMap<String, Vec<Option<f64>>>, slack_ms: f64 },
+    Callback(RetentionCallback),
+}
+struct Retention {
+    policy: RetentionPolicy,
+    arrivals: HashMap<u128, f64>,
+    last_completion: HashMap<String, f64>,
+    last_gap: HashMap<String, f64>,
+    completions: HashMap<String, usize>,
+    pauses: PauseHistogram,
+}
+static RETENTION: OnceLock<Mutex<Retention>> = OnceLock::new();
+pub fn set_retention(policy: RetentionPolicy) {
+    let state = Retention {
+        policy,
+        arrivals: HashMap::new(),
+        last_completion: HashMap::new(),
+        last_gap: HashMap::new(),
+        completions: HashMap::new(),
+        pauses: PauseHistogram::new(),
+    };
+    assert!(RETENTION.set(Mutex::new(state)).is_ok());
+}
+pub fn note_arrival(uuid: u128, now_ms: f64) {
+    if let Some(state) = RETENTION.get() { state.lock().unwrap().arrivals.insert(uuid, now_ms); }
+}
+/// Called once per completed request; returns the protection time for its copies.
+pub fn on_complete(uuid: u128, session_id: Option<&str>, input_tokens: usize, cached_input_tokens: usize, output_tokens: usize) -> f64 {
+    let Some(state) = RETENTION.get() else { return f64::NEG_INFINITY };
+    let mut state = state.lock().unwrap();
+    let now_ms = now();
+    let arrival_ms = state.arrivals.remove(&uuid).unwrap_or(now_ms);
+    let Some(session) = session_id else { return f64::NEG_INFINITY };
+    // Causal history: the pause before this request, seen only once it arrived.
+    if let Some(previous) = state.last_completion.get(session).copied() {
+        let gap = arrival_ms - previous;
+        if gap >= 0.0 {
+            state.last_gap.insert(session.to_string(), gap);
+            state.pauses.add(gap);
+        }
+    }
+    state.last_completion.insert(session.to_string(), now_ms);
+    let ordinal = *state.completions.entry(session.to_string()).and_modify(|count| *count += 1).or_insert(0);
+    let context = (input_tokens + output_tokens) as f64;
+    let until = match &state.policy {
+        RetentionPolicy::None => None,
+        RetentionPolicy::LastGap => state.last_gap.get(session).map(|gap| now_ms + gap),
+        RetentionPolicy::GlobalMedian => state.pauses.median().map(|gap| now_ms + gap),
+        RetentionPolicy::Continuum { reload, min_history, cold_mean_ms } => {
+            let benefit = reload[0] * context * context + reload[1] * context + reload[2];
+            let ttl = if state.pauses.total >= *min_history {
+                state.pauses.best_ttl(benefit)
+            } else if benefit > *cold_mean_ms {
+                cold_mean_ms * (benefit / cold_mean_ms).ln()
+            } else {
+                0.0
+            };
+            (ttl > 0.0).then_some(now_ms + ttl)
+        }
+        RetentionPolicy::Oracle { gaps, slack_ms } => gaps
+            .get(session)
+            .and_then(|values| values.get(ordinal).copied().flatten())
+            .map(|gap| now_ms + gap + slack_ms),
+        RetentionPolicy::Callback(callback) => {
+            let pause = Pause { session_id: Some(session.to_string()), arrival_ms, now_ms, input_tokens, cached_input_tokens, output_tokens };
+            callback(&pause).expect("invalid retention decision")
+        }
+    };
+    until.unwrap_or(f64::NEG_INFINITY)
+}
