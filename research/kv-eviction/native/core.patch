+// SPDX-License-Identifier: Apache-2.0
+//! Research-only hooks. No forecast, active-block access, or changes to scheduling.
+use std::fs::File;
+use std::io::Write;
+use std::path::Path;
+use std::sync::{Mutex, OnceLock};
+use std::sync::atomic::{AtomicU64, Ordering};
+use anyhow::Result;
+use serde::Serialize;
+
+#[derive(Serialize)]
+pub struct Candidate {
+    pub block_id: u64,
+    pub creation_order: u64,
+    pub release_order: u64,
+    pub num_releases: u64,
+    pub lru_rank: usize,
+    pub hit_count: u64,
+    pub last_access_order: u64,
+}
+type Callback = Box<dyn Fn(&[Candidate]) -> Result<u64> + Send + Sync>;
+static CALLBACK: OnceLock<Callback> = OnceLock::new();
+static TOKENS: OnceLock<Mutex<File>> = OnceLock::new();
+static EVICTIONS: AtomicU64 = AtomicU64::new(0);
+pub fn set_callback(callback: Callback) { assert!(CALLBACK.set(callback).is_ok()); }
+pub fn capture_tokens(path: impl AsRef<Path>) -> Result<()> {
+    assert!(TOKENS.set(Mutex::new(File::create(path)?)).is_ok()); Ok(())
+}
+pub fn enabled() -> bool { CALLBACK.get().is_some() }
+pub fn choose(candidates: &[Candidate]) -> u64 {
+    CALLBACK.get().expect("callback missing")(candidates).expect("invalid policy decision")
+}
+pub fn count_eviction() { EVICTIONS.fetch_add(1, Ordering::Relaxed); }
+pub fn evictions() -> u64 { EVICTIONS.load(Ordering::Relaxed) }
+pub fn token(uuid: impl std::fmt::Display, time_ms: f64) {
+    if let Some(file) = TOKENS.get() {
+        writeln!(file.lock().unwrap(), "{}", serde_json::json!({"uuid":uuid.to_string(),"time_ms":time_ms})).unwrap();
+    }
+}
