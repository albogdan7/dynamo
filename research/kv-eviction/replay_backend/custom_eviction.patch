+// SPDX-License-Identifier: Apache-2.0
+//! Research-only scoped hook for synchronous, single-worker SGLang replay.
+//! Callbacks must be pure: admission rollback may repeat candidate decisions.
+use std::cell::RefCell;
+use serde::Serialize;
+
+#[derive(Debug, Clone, Serialize)]
+pub struct LeafCandidate {
+    pub block_id: u64,
+    pub lru_rank: usize,
+    pub size_tokens: usize,
+    pub prefix_tokens: usize,
+}
+
+type Selector = Box<dyn FnMut(&[LeafCandidate]) -> u64>;
+thread_local! {
+    static SELECTOR: RefCell<Option<Selector>> = RefCell::new(None);
+}
+
+pub(crate) fn active() -> bool {
+    SELECTOR.with(|s| s.borrow().is_some())
+}
+
+pub(crate) fn select(candidates: &[LeafCandidate]) -> u64 {
+    SELECTOR.with(|s| s.borrow_mut().as_mut().expect("custom selector missing")(candidates))
+}
+
+/// Scope a stateless selector to this thread, restoring it even on panic.
+/// Does not change other threads or support asynchronous/multi-worker engines.
+pub fn with_leaf_selector<T>(selector: Selector, run: impl FnOnce() -> T) -> T {
+    assert!(!active(), "nested leaf selectors are unsupported");
+    SELECTOR.with(|s| *s.borrow_mut() = Some(selector));
+    struct Reset;
+    impl Drop for Reset {
+        fn drop(&mut self) { SELECTOR.with(|s| *s.borrow_mut() = None); }
+    }
+    let _reset = Reset;
+    run()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::engine::cache::radix_cache::RadixCache;
+
+    #[test]
+    fn custom_eviction_only_exposes_unlocked_leaves_and_preserves_parent() {
+        let mut cache = RadixCache::new(3, 1);
+        let pages = cache.page_pool.allocate(3).unwrap();
+        let locked = cache.insert(&[1, 2], &pages[..2]);
+        cache.insert(&[1, 3], &[pages[0], pages[2]]);
+        cache.inc_lock_ref(locked);
+        let (evicted, _) = with_leaf_selector(Box::new(|leaves| {
+            assert_eq!(leaves.len(), 1);
+            assert_eq!(leaves[0].prefix_tokens, 1);
+            assert_eq!(leaves[0].size_tokens, 1);
+            leaves[0].block_id
+        }), || cache.evict(1));
+        assert_eq!(evicted, 1);
+        assert_eq!(cache.prefix_match_len(&[1, 2]), 2);
+        assert_eq!(cache.prefix_match_len(&[1, 3]), 1);
+        assert!(!active());
+    }
+
+    #[test]
+    fn custom_eviction_invalid_id_fails_before_mutation_and_restores_scope() {
+        let mut cache = RadixCache::new(1, 1);
+        let pages = cache.page_pool.allocate(1).unwrap();
+        cache.insert(&[7], &pages);
+        let failure = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            with_leaf_selector(Box::new(|_| u64::MAX), || cache.evict(1))
+        }));
+        assert!(failure.is_err());
+        assert!(!active());
+        assert_eq!(cache.prefix_match_len(&[7]), 1);
+        assert_eq!(cache.evict(1).0, 1);
+    }
+}
