+                    LeafCandidate {
+                        block_id: id.data().as_ffi(),
+                        lru_rank: rank,
+                        size_tokens: node.key.len() * self.page_size,
+                        prefix_tokens,
+                    }
+                }).collect();
+                let selected = custom_eviction::select(&candidates);
+                let (accessed, id) = indexed.into_iter()
+                    .find(|(_, id)| id.data().as_ffi() == selected)
+                    .expect("custom policy returned an ineligible radix leaf");
+                assert!(self.is_evictable_leaf(id));
+                self.remove_evictable_leaf(id);
+                Some((accessed, id))
+            } else if let Some(belady) = &self.belady {
